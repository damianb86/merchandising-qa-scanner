# Merchandising QA Scanner
# Copy to .env for local development. Do not commit real secrets.

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://example.com
SCOPES=read_products,read_inventory,read_publications
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/merchandising_qa_scanner
SHOP_CUSTOM_DOMAIN=
NODE_ENV=development

# Docker deployment placeholders
COMPOSE_PROJECT_NAME=merchandising-qa-scanner
APP_DB_NAME=merchandising_qa_scanner
APP_DB_USER=merchandising_qa_scanner_user
APP_DB_PASSWORD=replace_me
APP_HOST=merchandising-qa-scanner.example.com
CONTACT_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
NODE_OPTIONS=
